<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carwash.ui.controller.MainController">
   <left>
      <VBox fx:id="sidebarMenu" prefWidth="250.0" styleClass="sidebar">
         <children>
            <!-- Header -->
            <VBox styleClass="sidebar-header">
               <children>
                  <Label text="Carwash Peña Blanca" styleClass="sidebar-title">
                     <font>
                        <Font name="Arial Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="todayDateLabel" styleClass="sidebar-date" />
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" left="15.0" right="15.0" top="15.0" />
               </VBox.margin>
            </VBox>
            
            <!-- Menu Buttons -->
            <VBox styleClass="sidebar-menu">
               <children>
                  <Button fx:id="dashboardBtn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📊 Dashboard">
                     <VBox.margin>
                        <Insets bottom="5.0" left="15.0" right="15.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button fx:id="appointmentsBtn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📅 Citas">
                     <VBox.margin>
                        <Insets bottom="5.0" left="15.0" right="15.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button fx:id="customersBtn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="👥 Clientes">
                     <VBox.margin>
                        <Insets bottom="5.0" left="15.0" right="15.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button fx:id="servicesBtn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="🔧 Servicios">
                     <VBox.margin>
                        <Insets bottom="5.0" left="15.0" right="15.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button fx:id="inventoryBtn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📦 Inventario">
                     <VBox.margin>
                        <Insets bottom="5.0" left="15.0" right="15.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button fx:id="invoicesBtn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="🧾 Facturas">
                     <VBox.margin>
                        <Insets bottom="5.0" left="15.0" right="15.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button fx:id="reportsBtn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="📈 Reportes">
                     <VBox.margin>
                        <Insets bottom="5.0" left="15.0" right="15.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Button fx:id="settingsBtn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="menu-button" text="⚙️ Configuración">
                     <VBox.margin>
                        <Insets bottom="5.0" left="15.0" right="15.0" top="20.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
            
            <!-- Quick Stats -->
            <VBox styleClass="sidebar-stats">
               <children>
                  <Label text="Estadísticas Rápidas" styleClass="stats-title">
                     <font>
                        <Font name="Arial Bold" size="12.0" />
                     </font>
                  </Label>
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Citas Hoy:" />
                        <Label fx:id="todayAppointmentsLabel" styleClass="stat-value" text="0" />
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Clientes:" />
                        <Label fx:id="totalCustomersLabel" styleClass="stat-value" text="0" />
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Servicios:" />
                        <Label fx:id="activeServicesLabel" styleClass="stat-value" text="0" />
                     </children>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="20.0" />
               </VBox.margin>
            </VBox>
         </children>
      </VBox>
   </left>
   
   <top>
      <VBox styleClass="header">
         <children>
            <Label fx:id="welcomeLabel" styleClass="welcome-message" text="¡Bienvenido al Sistema de Gestión Carwash Peña Blanca!">
               <font>
                  <Font name="Arial Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </top>
   
   <center>
      <!-- El contenido dinámico se cargará aquí -->
      <VBox alignment="CENTER" spacing="20.0" styleClass="content-area">
         <children>
            <Label text="Cargando..." styleClass="loading-message">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </center>
</BorderPane>