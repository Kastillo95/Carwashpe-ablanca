<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Dashboard Header -->
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label text="📊 Dashboard - Resumen General" styleClass="card-title">
               <font>
                  <Font name="Arial Bold" size="20.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </HBox>
      
      <!-- Statistics Cards Row -->
      <HBox alignment="CENTER" spacing="20.0" styleClass="dashboard-stats">
         <children>
            <!-- Today's Appointments Card -->
            <VBox styleClass="stat-card">
               <children>
                  <Label text="📅" style="-fx-font-size: 24px;" />
                  <Label fx:id="todayAppointmentsCount" text="0" styleClass="stat-number" />
                  <Label text="Citas de Hoy" styleClass="stat-description" />
               </children>
            </VBox>
            
            <!-- Total Customers Card -->
            <VBox styleClass="stat-card">
               <children>
                  <Label text="👥" style="-fx-font-size: 24px;" />
                  <Label fx:id="totalCustomersCount" text="0" styleClass="stat-number" />
                  <Label text="Clientes Totales" styleClass="stat-description" />
               </children>
            </VBox>
            
            <!-- Daily Revenue Card -->
            <VBox styleClass="stat-card">
               <children>
                  <Label text="💰" style="-fx-font-size: 24px;" />
                  <Label fx:id="dailyRevenueAmount" text="$0.00" styleClass="stat-number" />
                  <Label text="Ingresos Hoy" styleClass="stat-description" />
               </children>
            </VBox>
            
            <!-- Active Services Card -->
            <VBox styleClass="stat-card">
               <children>
                  <Label text="🔧" style="-fx-font-size: 24px;" />
                  <Label fx:id="activeServicesCount" text="0" styleClass="stat-number" />
                  <Label text="Servicios Activos" styleClass="stat-description" />
               </children>
            </VBox>
         </children>
         <VBox.margin>
            <Insets bottom="30.0" left="20.0" right="20.0" />
         </VBox.margin>
      </HBox>
      
      <!-- Today's Appointments Section -->
      <VBox styleClass="card">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="📅 Citas de Hoy" styleClass="card-title">
                     <font>
                        <Font name="Arial Bold" size="16.0" />
                     </font>
                  </Label>
                  <Button text="+ Nueva Cita" styleClass="primary-button" />
               </children>
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
            </HBox>
            
            <TableView fx:id="todayAppointmentsTable" prefHeight="250.0">
               <columns>
                  <TableColumn prefWidth="120.0" text="Hora" />
                  <TableColumn prefWidth="180.0" text="Cliente" />
                  <TableColumn prefWidth="150.0" text="Servicio" />
                  <TableColumn prefWidth="120.0" text="Estado" />
                  <TableColumn prefWidth="150.0" text="Acciones" />
               </columns>
            </TableView>
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </VBox.margin>
      </VBox>
      
      <!-- Quick Actions Section -->
      <HBox spacing="20.0">
         <children>
            <!-- Recent Customers Card -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="👥 Clientes Recientes" styleClass="card-title">
                     <font>
                        <Font name="Arial Bold" size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="15.0" />
                     </VBox.margin>
                  </Label>
                  
                  <ListView fx:id="recentCustomersList" prefHeight="200.0" />
               </children>
            </VBox>
            
            <!-- Low Stock Items Card -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="⚠️ Stock Bajo" styleClass="card-title">
                     <font>
                        <Font name="Arial Bold" size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="15.0" />
                     </VBox.margin>
                  </Label>
                  
                  <ListView fx:id="lowStockItemsList" prefHeight="200.0" />
               </children>
            </VBox>
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>